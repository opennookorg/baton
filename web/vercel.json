{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(stats|curve|route|graph)", "destination": "https://kartik017-baton.hf.space/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
